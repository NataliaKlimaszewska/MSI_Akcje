import yfinance as yf
import numpy as np
import pandas as pd
from sklearn.preprocessing import MinMaxScaler
from tensorflow import keras
from tensorflow.keras import layers
import matplotlib.pyplot as plt
import streamlit as st  # Zaimportuj Streamlit

# --- KROK 1: Konfiguracja (Stałe parametry) ---
WINDOW_SIZE = 40
TRAIN_START_DATE = "2015-01-01"
TRAIN_END_DATE = "2020-01-01"
ANOMALY_THRESHOLD_PERCENTILE = 98

# --- Funkcja do tworzenia sekwencji ---
def create_sequences(data, window_size):
    sequences = []
    for i in range(len(data) - window_size):
        sequences.append(data[i:(i + window_size)])
    return np.array(sequences)

# --- Funkcja do budowania i trenowania modelu ---
# @st.cache_resource to "magia" Streamlit:
# Mówi mu, żeby nie trenował modelu od zera za każdym razem,
# gdy zmienisz coś w UI, tylko użył wersji z pamięci podręcznej.
# To DRASTYCZNIE przyspiesza działanie aplikacji.
@st.cache_resource
def build_and_train_model(X_train, ticker):
    st.info(f"Rozpoczynam trening 'eksperta normalności' dla {ticker}...")
    
    input_dim = X_train.shape[1]
    latent_dim = 8
    
    input_layer = keras.Input(shape=(input_dim,))
    encoder = layers.Dense(32, activation='relu')(input_layer)
    encoder = layers.Dense(16, activation='relu')(encoder)
    encoder_output = layers.Dense(latent_dim, activation='relu')(encoder)
    decoder = layers.Dense(16, activation='relu')(encoder_output)
    decoder = layers.Dense(32, activation='relu')(decoder)
    decoder_output = layers.Dense(input_dim, activation='sigmoid')(decoder)
    autoencoder = keras.Model(inputs=input_layer, outputs=decoder_output)
    
    autoencoder.compile(optimizer='adam', loss='mean_squared_error')
    
    autoencoder.fit(
        X_train, X_train,
        epochs=50, batch_size=32,
        validation_split=0.1, 
        verbose=0
    )
    st.success(f"Trening dla {ticker} zakończony!")
    return autoencoder

# --- KROK 3: Główna logika aplikacji Streamlit ---

# st.title -> Tytuł, który pojawi się na górze aplikacji
st.title("📈 Interaktywny Monitor Anomalii Rynkowych")
st.write(f"Model jest trenowany na 'normalnym' okresie: {TRAIN_START_DATE} do {TRAIN_END_DATE}")

# st.text_input -> Zastępuje input()
ticker = st.text_input("Podaj ticker spółki (np. NVDA, MSFT, AAPL):", "").upper()

# Przycisk do uruchomienia analizy
if st.button("Analizuj"):
    if ticker: # Sprawdź, czy użytkownik cokolwiek wpisał
        
        # st.spinner -> Pokazuje ładną animację ładowania
        with st.spinner(f"Przetwarzanie {ticker}... To może zająć minutę..."):
            
            # a) Pobierz dane
            st.info(f"Pobieranie danych dla {ticker}...")
            data = yf.download(ticker, start=TRAIN_START_DATE)
            if data.empty:
                st.error(f"BŁĄD: Nie znaleziono danych dla {ticker}. Spróbuj ponownie.")
            else:
                df = data[['Close']]
                
                # b) Przetwarzanie danych
                scaler = MinMaxScaler(feature_range=(0, 1))
                data_scaled = scaler.fit_transform(df)
                sequences_all = np.squeeze(create_sequences(data_scaled, WINDOW_SIZE))
                sequence_end_dates = df.index[WINDOW_SIZE:]

                # c) Wydziel dane treningowe
                train_indices = np.where(sequence_end_dates < TRAIN_END_DATE)[0]
                X_train = sequences_all[train_indices]

                if len(X_train) < 100:
                    st.error(f"BŁĄD: Zbyt mało danych treningowych dla {ticker}.")
                else:
                    # d) Buduj i trenuj model (używając funkcji z cache)
                    autoencoder = build_and_train_model(X_train, ticker)
                    
                    # e) Analiza całej historii
                    st.info(f"Analiza całej historii {ticker}...")
                    reconstructions = autoencoder.predict(sequences_all, verbose=0)
                    reconstruction_errors = np.mean(np.abs(reconstructions - sequences_all), axis=1)
                    
                    errors_train = reconstruction_errors[train_indices]
                    threshold = np.percentile(errors_train, ANOMALY_THRESHOLD_PERCENTILE)
                    
                    # f) Przygotowanie wyników
                    results_df = pd.DataFrame(index=sequence_end_dates)
                    results_df['Close'] = df['Close'][WINDOW_SIZE:]
                    results_df['Reconstruction_Error'] = reconstruction_errors
                    results_df['Anomaly'] = results_df['Reconstruction_Error'] > threshold
                    anomalous_data = results_df[results_df['Anomaly'] == True]
                    
                    # g) --- PRAKTYCZNY WNIOSEK (na co dzień) ---
                    recent_anomalies = results_df.iloc[-30:][results_df['Anomaly'] == True]
                    
                    # st.subheader -> Tworzy nagłówek
                    st.subheader(f"Podsumowanie dla {ticker}:")
                    if not recent_anomalies.empty:
                        st.error(f"🔴🔴🔴 UWAGA: Wykryto {len(recent_anomalies)} anomalii w ostatnich 30 dniach!")
                        # st.dataframe -> Wyświetla ładną tabelkę
                        st.dataframe(recent_anomalies[['Close', 'Reconstruction_Error']])
                    else:
                        st.success(f"🟢🟢🟢 Spokojnie: Brak znaczących anomalii w ostatnich 30 dniach.")
                    
                    # h) Wizualizacja
                    st.subheader(f"Wykres anomalii dla {ticker}:")
                    # Tworzymy wykres tak jak poprzednio, ale nie pokazujemy go
                    fig = plt.figure(figsize=(16, 8))
                    plt.plot(results_df.index, results_df['Close'], color='blue', label=f'Cena {ticker}')
                    plt.scatter(
                        anomalous_data.index, 
                        anomalous_data['Close'], 
                        color='red', marker='o', s=50, 
                        label='Wykryta Anomalia'
                    )
                    plt.title(f'Detekcja Anomalii dla {ticker}')
                    plt.xlabel('Data')
                    plt.ylabel('Cena Zamknięcia (USD)')
                    plt.legend()
                    plt.grid(True)
                    
                    # st.pyplot -> Pokazuje wykres w aplikacji
                    st.pyplot(fig)

    else:
        st.info("Wpisz ticker spółki (np. 'AAPL') i kliknij 'Analizuj'.")